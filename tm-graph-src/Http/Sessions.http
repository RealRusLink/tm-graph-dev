### 7. Duplicate register: 409
POST {{host}}/api/User/register
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("duplicate register: 409 Conflict", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
    });
%}


### 8. Wrong password: 400
POST {{host}}/api/User/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{email}}",
  "password": "wrong-password"
}

> {%
    client.test("wrong password: 400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}
