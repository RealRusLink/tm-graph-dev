# Env: dev (http-client.env.json + http-client.private.env.json).
# First run: copy http-client.private.env.example.json and fill it.
# Start: dotnet run --launch-profile https
# After register, put the emailed code into verificationCode, then run confirm.
# remember_me = true uses the long session lifetime, false uses the short one.
# Change username/email (or delete app.db) between runs to avoid 409.
# Cookies are handled automatically.


### 1. Register
# @name register
POST {{host}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("register: 202 Accepted", function () {
        client.assert(response.status === 202, "Expected 202, got " + response.status);
    });
%}


### 2. Confirm
# @name confirm
POST {{host}}/api/auth/confirm
Content-Type: application/json
Accept: application/json

{
  "code": "{{verificationCode}}",
  "remember_me": false
}

> {%
    client.test("confirm: 200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}


### 3. Login by email
# @name loginByEmail
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{email}}",
  "password": "{{password}}",
  "remember_me": false
}

> {%
    client.test("login by email: 200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}


### 4. Logout
# @name logout
POST {{host}}/api/auth/logout
Accept: application/json

> {%
    client.test("logout: 204 No Content", function () {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}


### 5. Login by username
# @name loginByUsername
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{username}}",
  "password": "{{password}}",
  "remember_me": true
}

> {%
    client.test("login by username: 200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}


### 6. Logout
# @name logoutByUsername
POST {{host}}/api/auth/logout
Accept: application/json

> {%
    client.test("logout: 204 No Content", function () {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}


### 7. Duplicate register: 409
POST {{host}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("duplicate register: 409 Conflict", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
    });
%}


### 8. Wrong password: 400
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{email}}",
  "password": "wrong-password",
  "remember_me": false
}

> {%
    client.test("wrong password: 400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}


### 9. Unknown email: 400 (same as wrong password)
POST {{host}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "missing@example.com",
  "password": "wrong-password",
  "remember_me": false
}

> {%
    client.test("unknown email: 400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}
