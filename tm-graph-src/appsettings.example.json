{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Db": {
    "ConnectionString": "Data Source=app.db"
  },
  "Email": {
    "SmtpServer": "smtp.example.com",
    "Port": 587,
    "Address": "no-reply@example.com",
    "Password": "replace-me",
    "FromName": "App",
    "SecureSocketOption": "StartTls"
  },
  "EmailVerificationCode": {
    "TtlSeconds": 900,
    "EmailSubject": "Verification code",
    "EmailBodyTemplate": "Your code is {code}"
  },
  "Session": {
    "ShortLifetime": "02:00:00",
    "LongLifetime": "30.00:00:00"
  }
}
